{
  "binds": [
    {"el": "v-pv1w", "key": "pv1_power", "dec": 0, "unit": "W"},
    {"el": "v-pv1v", "key": "pv1_voltage", "dec": 0, "unit": "V"},
    {"el": "v-pv1a", "key": "pv1_current", "dec": 1, "unit": "A"},
    {"el": "v-pv2w", "key": "pv2_power", "dec": 0, "unit": "W"},
    {"el": "v-pv2v", "key": "pv2_voltage", "dec": 0, "unit": "V"},
    {"el": "v-pv2a", "key": "pv2_current", "dec": 1, "unit": "A"},

    {"el": "v-mode", "key": "mode"},
    {"el": "v-util", "key": "ac_output_percent", "dec": 0, "unit": "%", "title": "Overall output utilization (load vs rated)"},
    {"el": "v-temp", "key": "inner_temp", "dec": 0, "unit": "°C"},
    {"el": "v-feedmax", "key": "feed_grid_max_power", "dec": 0, "unit": "W max feed"},
    {"el": "v-outfreq", "key": "ac_output_frequency", "dec": 2, "unit": "Hz"},

    {"el": "v-gridr-v", "key": "grid_voltage_r", "dec": 0, "unit": "V"},
    {"el": "v-gridr-a", "key": "grid_current_r", "dec": 1, "unit": "A"},
    {"el": "v-grids-v", "key": "grid_voltage_s", "dec": 0, "unit": "V"},
    {"el": "v-grids-a", "key": "grid_current_s", "dec": 1, "unit": "A"},
    {"el": "v-gridt-v", "key": "grid_voltage_t", "dec": 0, "unit": "V"},
    {"el": "v-gridt-a", "key": "grid_current_t", "dec": 1, "unit": "A"},
    {"el": "v-gridw", "key": "grid_in_power_total", "dec": 0, "unit": "W",
     "title": "Grid power — AC-input power, else grid V×I, else AC-output power",
     "fallback": {"expr": "grid_voltage_r*grid_current_r+grid_voltage_s*grid_current_s+grid_voltage_t*grid_current_t",
                  "fallback": {"key": "ac_output_power_total"}}},
    {"el": "v-gridf", "key": "grid_frequency", "dec": 2, "unit": "Hz"},

    {"el": "v-loadr-w", "key": "ac_output_power_r", "dec": 0, "unit": "W", "title": "AC output power R"},
    {"el": "v-loadr-a", "key": "ac_output_current_r", "dec": 1, "unit": "A", "fallback": {"key": "ac_output_voltage_r", "unit": "V"}, "title": "AC output R — current if reported, otherwise voltage"},
    {"el": "v-loads-w", "key": "ac_output_power_s", "dec": 0, "unit": "W", "title": "AC output power S"},
    {"el": "v-loads-a", "key": "ac_output_current_s", "dec": 1, "unit": "A", "fallback": {"key": "ac_output_voltage_s", "unit": "V"}, "title": "AC output S — current if reported, otherwise voltage"},
    {"el": "v-loadt-w", "key": "ac_output_power_t", "dec": 0, "unit": "W", "title": "AC output power T"},
    {"el": "v-loadt-a", "key": "ac_output_current_t", "dec": 1, "unit": "A", "fallback": {"key": "ac_output_voltage_t", "unit": "V"}, "title": "AC output T — current if reported, otherwise voltage"},
    {"el": "v-loadw", "key": "ac_output_power_total", "dec": 0, "unit": "W"},
    {"el": "v-loadpct", "key": "ac_output_percent", "dec": 0, "unit": "% load"},

    {"el": "v-battw", "key": "battery_power", "dec": 0, "unit": "W", "fallback": {"expr": "battery_voltage*battery_current", "unit": "W"}},
    {"el": "v-battv", "key": "battery_voltage", "dec": 1, "unit": "V"},
    {"el": "v-batta", "key": "battery_current", "dec": 1, "unit": "A", "fallback": {"expr": "battery_power/battery_voltage", "unit": "A"}},
    {"el": "v-battc", "key": "battery_capacity", "dec": 0, "unit": "%"}
  ],
  "flows": [
    {"el": "flow-pv1",  "key": "pv1_power", "min": 10},
    {"el": "flow-pv2",  "key": "pv2_power", "min": 10},
    {"el": "flow-grid", "key": "grid_in_power_total", "min": 20, "fallback": {"key": "ac_output_power_total"}},
    {"el": "flow-load", "key": "ac_output_power_total", "min": 15},
    {"el": "flow-batt", "key": "battery_power", "min": 15, "invert": true, "fallback": {"expr": "battery_voltage*battery_current"}}
  ],
  "states": [
    {
      "el": "v-battstate",
      "key": "battery_power",
      "fallback": {"expr": "battery_voltage*battery_current"},
      "deadband": 15,
      "pos": {"text": "▲ Charging", "color": "#3ddc84"},
      "neg": {"text": "▼ Discharging", "color": "#ff5c5c"},
      "zero": {"text": "Idle", "color": "#8494a5"}
    },
    {
      "el": "v-gridstate",
      "key": "line_direction",
      "map": {
        "0": {"text": "Idle", "color": "#8494a5"},
        "1": {"text": "◀ Importing", "color": "#ffb454"},
        "2": {"text": "▶ Exporting", "color": "#3ddc84"}
      },
      "zero": {"text": "—", "color": "#8494a5"}
    }
  ]
}
